# Fragment: in die globale Caddyfile einfuegen (Platzhalter MANUELL fuellen:
# __EDGE_BASIC__     = base64("<AUTH_USER>:<Login-Passwort>") — die Login-Kennung
#   der Login-Seite, NICHT das opencode-Server-Passwort (Root-AGENTS.md §4):
#   source .env && printf '%s:%s' "$AUTH_USER" '<Login-Passwort>' | base64
# __OPENCODE_BASIC__ = base64("opencode:<OPENCODE_PASSWORD>") — Upstream-Injektion:
#   source .env && printf 'opencode:%s' "$OPENCODE_PASSWORD" | base64),
# Platzhalter zum Ersetzen: __CODE_DOMAIN__, __CODE_SITE__, __EDGE_BASIC__,
# __OPENCODE_BASIC__, __CORS_ORIGIN__ (nur die eigene PWA-Origin). Unersetzt ist
# die Datei trotzdem syntaktisch gueltiges Caddy und liefert still
# `Access-Control-Allow-Origin: __CORS_ORIGIN__` bzw. einen 401 an der Edge
# (@api_ok matcht nie) — der Browser lehnt die Response ab, ohne dass im
# Caddy-Log etwas auffaellt.
# dann dort ./sync.sh (validate + reload). Nicht als eigenes Caddyfile nutzen.
# Voraussetzung: Portainer-Stack code-auth laeuft, SSH-Tunnel Mac -> VPS auf 172.18.0.1:18731.
__CODE_DOMAIN__ {
	import security_headers
	import compress

	# statische Login-Seite (via rsync/ssh aus apps/web/dist synchronisiert)
	handle /login.html {
		root * /srv/websites/__CODE_SITE__
		file_server
	}

	# Login-API an Sidecar (setzt HMAC-Cookie)
	handle /api/login {
		reverse_proxy code-auth:8081
	}
	handle /api/me {
		reverse_proxy code-auth:8081
	}
	handle /api/logout {
		reverse_proxy code-auth:8081
	}

	# OpenCode-SW precacht ein nicht existentes Asset (bad-precaching-response)
	# und serviert danach alte 404s aus dem Cache -> durch leeren Worker
	# neutralisieren (exaktes Handle sticht das Catch-all unten aus).
	handle /sw.js {
		header Content-Type "application/javascript"
		respond `/* service worker disabled */` 200
	}

	# CORS-Preflight (PWA __CORS_ORIGIN__): OPTIONS traegt nie Cookies,
	# forward_auth antwortete mit 302 und der Browser brach den Preflight ab
	# (gemessen 2026-10-07). Deshalb hier beantworten, bevor das Catch-all
	# greift. ACAO an echten Responses SOLL opencode serve --cors liefern
	# (run.sh, Key CORS_ORIGIN in .env) — unbelegt, s. remote/AGENTS.md §19.
	#
	# Grenze: die pfadspezifischen Handles DARUEBER (/login.html, /api/login,
	# /api/me, /api/logout, /sw.js) stehen vor diesem Block. Das ist
	# Quellreihenfolge per stabilem Sort, keine Absicht: der Pfad-Sub-Sort
	# (sortRoutes in caddyconfig/httpcaddyfile/directives.go) greift nur, wenn
	# BEIDE Routen genau einen Single-Path-Matcher haben; @options matcht per
	# method, also sagt der Comparator nur "beide haben einen Matcher" = gleich.
	# Ein OPTIONS darauf trifft diesen Block NIE:
	#   /api/login|me|logout -> Sidecar, kennt nur do_GET/do_POST, kein
	#     do_OPTIONS (Beleg: remote/docker-compose.yml) -> 501 ohne CORS-Header
	#   /sw.js               -> das eigene respond 200, ohne CORS-Header
	#   /login.html          -> file_server, ohne CORS-Header
	# Heute harmlos (Login ist same-origin, kein Preflight noetig), latente
	# Falle sobald das Login cross-origin wird.
	#
	# Reichweite: dieses Blanket-OPTIONS umgeht forward_auth fuer ALLE
	# uebrigen Pfade. Das ist statisch und bodyless, der Upstream sieht
	# nichts davon, es ist nichts preisgegeben. Aber kuenftige Endpunkte, die
	# selbst OPTIONS tragen (WebDAV-Discovery o.ae.), wuerden hier maskiert.
	#
	# OFFEN: die Allow-Headers-Liste ist geraten. Aus dem echten
	# Access-Control-Request-Headers ableiten (DevTools-Netz-Tab der PWA).
	@options method OPTIONS
	handle @options {
		header Access-Control-Allow-Origin "__CORS_ORIGIN__"
		header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
		header Access-Control-Allow-Headers "Authorization, Content-Type"
		header Access-Control-Allow-Credentials "true"
		header Access-Control-Max-Age "86400"
		respond "" 204
	}

	# /api/* for the PWA: edge gate on the EMBEDDED credential — exact match
	# on the full base64 header. No username lookup, no password hash to
	# maintain at the edge. The edge credential (__EDGE_BASIC__, the login
	# credential the PWA sends per request) and the upstream server password
	# (__OPENCODE_BASIC__, what opencode expects) are independent strings and
	# rotate independently: changing OPENCODE_PASSWORD only touches the
	# header_up lines, changing the login credential only touches the @api_ok
	# matcher below.
	#
	# Cookie gate untouched: /api/login, /api/me, /api/logout stay ABOVE
	# (source order, stable sort) on forward_auth, and requests WITHOUT an
	# Authorization header fall through to the catch-all cookie gate — that
	# is the browser Web-UI path.
	#
	# ORDERING (load-bearing): @options > @api_ok > @api_denied. All three
	# matchers fall in the same comparator class (has a matcher), so source
	# order is kept. @api_ok BEFORE @api_denied: allowed requests match both,
	# but handles are exclusive, first match wins. Either of them ABOVE
	# @options kills the preflight (OPTIONS carries no Authorization).
	@api_ok {
		path /api/*
		header Authorization "Basic __EDGE_BASIC__"
	}
	handle @api_ok {
		reverse_proxy 172.18.0.1:18731 {
			header_up Authorization "Basic __OPENCODE_BASIC__"
			transport http {
				versions 1.1
				keepalive 4s
			}
			stream_timeout 24h
			stream_close_delay 5m
		}

		# ACAO/ACAC on the real responses (sibling of reverse_proxy, NOT
		# inside it — header is no reverse_proxy subdirective). defer lets
		# proxy responses override later-set headers.
		header {
			Access-Control-Allow-Origin "__CORS_ORIGIN__"
			Access-Control-Allow-Credentials "true"
			Vary Origin
			defer
		}
	}

	# Wrong credential WITH an Authorization header -> direct 401 WITH ACAO
	# (never the cookie gate: that would 302 and the PWA would see a CORS
	# failure instead of Unauthorized). No WWW-Authenticate header here, so
	# the browser never pops its native password dialog on this path.
	@api_denied {
		path /api/*
		header Authorization *
	}
	handle @api_denied {
		header {
			Access-Control-Allow-Origin "__CORS_ORIGIN__"
			Access-Control-Allow-Credentials "true"
			Vary Origin
		}
		respond "Unauthorized" 401
	}

	# alles andere: Cookie pruefen, dann SSH-Tunnel zum Mac.
	# 401 vom Sidecar -> Redirect auf Login (handle_response: forward_auth
	# reicht die 401-Antwort direkt durch, handle_errors greift dort nicht).
	handle {
		forward_auth code-auth:8081 {
			# Auth-Preflight bewusst als kurze HTTP/1.1-Verbindung: der
			# Python-Sidecar ist HTTP/1.0 und soll keinen Idle-Pool aufbauen.
			transport http {
				versions 1.1
				keepalive off
			}
			uri /check?
			copy_headers Remote-User
			@denied status 401
			handle_response @denied {
				redir * /login.html 302
			}
		}
		# Ziel = Docker-Bridge-Gateway (webnet .1): dort bindet der SSH-Forward;
		# 127.0.0.1 saehe hier nur den Container-Loopback.
		reverse_proxy 172.18.0.1:18731 {
			# OpenCode-eigenes Passwort upstream injizieren (Browser sieht es nie).
			# PLATZHALTER — nie echten Wert committen! Lokal erzeugen (siehe Root-README)
			# und in die globale Caddyfile uebernehmen.
			header_up Authorization "__OPENCODE_BASIC__"

			# Direkter, authentisierter Healthcheck durch denselben SSH-Tunnel:
			# er erkennt einen toten oder nicht mehr erreichbaren Mac-Upstream.
			health_uri /api/info
			health_interval 30s
			health_timeout 4s
			health_status 200
			health_fails 3
			health_headers {
				Authorization "__OPENCODE_BASIC__"
			}

			# Gleicher Upstream-Transport wie im Remote-Stack: Browser->Caddy
			# darf HTTP/2 bleiben; Caddy->OpenCode nutzt HTTP/1.1 und kurzes
			# Keepalive, damit keine abgelaufenen Tunnel-Sockets wiederverwendet
			# werden.
			transport http {
				versions 1.1
				keepalive 4s
			}

			# WebSocket-Upgrades (z.B. PTY) begrenzen; SSE bleibt davon unberührt.
			stream_timeout 24h
			# Beim Caddy-Reload den Abbruch alter WebSocket-Streams verzögern.
			stream_close_delay 5m

			# Caddy puffert SSE automatisch. Kein globales flush_interval -1:
			# es ist redundant und würde auch alle normalen Responses beeinflussen.
		}
	}

	# Tunnel tot (Dial-Fehler 502, Mac offline) -> eigene Offline-Seite.
	# Feuert nur bei Proxy-Transportfehlern (forward_auth-401 laeuft nicht hierher).
	handle_errors {
		@gw expression `{err.status_code} == 502 || {err.status_code} == 503 || {err.status_code} == 504`
		handle @gw {
			root * /srv/websites/__CODE_SITE__
			rewrite * /tunnel-down.html
			file_server
		}
	}
}
