# Beispiel-Umgebung. Kopieren nach `.env` via `./setup.sh`.
# Diese Datei committen, `.env` + `.env.production` nie (stehen in .gitignore).
# Echte Domains/Hosts nur in `.env` (lokal) bzw. `.env.production` (Portainer).

# --- Domains (Platzhalter ersetzen!) ---
CODE_DOMAIN=code.example.com
REMOTE_DOMAIN=remote-code.example.com
# Verzeichnisname unter /srv/websites auf dem VPS (oft = CODE_DOMAIN)
CODE_SITE=code.example.com
ADMIN_EMAIL=admin@example.com

# --- Tunnel ---
SSH_TARGET=user@vps.example.com
SSH_PORT=22
# VPS-Seite (fixer High-Port, kein Random — sonst Caddy-Reload nötig)
REMOTE_PORT=18731
# Bind-Adresse des Forwards auf dem VPS. Muss die Docker-Bridge sein (webnet-Gateway),
# weil Caddy im Bridge-Netz läuft und den VPS-Loopback nicht sieht.
# Braucht serverseitig: GatewayPorts clientspecified in /etc/ssh/sshd_config + reload.
REMOTE_BIND=172.18.0.1
# Mac-Seite (OpenCode-Web Default)
LOCAL_PORT=8080
# Setzt local/bootstrap.sh (beim Start via start-tunnel.command): der bestehende
# Key wird fuer den LaunchAgent nutzbar gemacht (Passphrase wandert einmalig in
# die macOS-Keychain, damit ssh ohne TTY connecten kann). Von Hand nicht setzen —
# bootstrap.sh pflegt beide Werte.
# SSH_IDENTITY=/Users/DEIN_NAME/.ssh/id_rsa
# SSH_KEY_AUTH=1
# Fixes Passwort fuer opencode serve (Pflicht). Caddy injiziert es per
# Authorization-Header upstream -> im Browser unsichtbar (de facto deaktiviert).
# Generiert setup.sh via: openssl rand -base64 24
OPENCODE_PASSWORD=

# --- Website-Sync (rsync/ssh, Ziel = SSH_TARGET + diese Pfade) ---
# /srv/websites im caddy-Container ist ein Bind-Mount auf
# SYNC_SITES_ROOT/SYNC_SITE_DIR. Der alte Weg (rclone, SFTPGo auf Port 2222,
# User webadmin) ist tot — der Host-Key ist rotiert, rclone brach ab.
SYNC_SITES_ROOT=/home/webadmin/websites
SYNC_SITE_DIR=code.example.com
# Pfad relativ zu local/ (run.sh/sync.sh wechseln in dieses Verzeichnis)
LOCAL_DIST=apps/web/dist

# --- code-auth Sidecar (Portainer-Stack, webnet) ---
AUTH_USER=admin
# bcrypt-Hash via: docker run --rm caddy:2 caddy hash-password --plaintext 'PASSWORT'
# Fallback ohne Docker: pbkdf2-Format von setup.sh (pbkdf2$100000$salt$hash)
# HIER unescaped eintragen: $2a$14$…
# In remote/.env.production dagegen MIT $$ ($2a$14$…), weil Portainer den Wert
# interpolated, bevor er den Container erreicht. Siehe AGENTS.md Abschnitt 2.
AUTH_HASH=
# 64 Hex-Chars, generiert setup.sh via: openssl rand -hex 32
AUTH_SECRET=
# statische webnet-IP (nächster freier Block nach .55 countdown, .253 ftp)
AUTH_IP=172.18.0.60
AUTH_PORT=8081
# Session-TTL in Sekunden (12h)
SESSION_TTL=43200

# --- code-remote (VPS-nativ, zweiter Weg neben Mac-Tunnel) ---
# Domain + Image. Keine Secrets hier — echte Werte in .env (lokal) bzw. Portainer.
REMOTE_DOMAIN=remote-code.example.com
IMAGE=ghcr.io/reisi007/opencode-web-dev-baseline:latest
# Ressourcenlimits fuer code-dev. Stand 2026-09-30.
# WICHTIG: MEMSWAP_LIMIT ist der GESAMT-Deckel aus RAM+Swap, nicht der
# Swap-Anteil. 5g/9g heisst 5 GB RAM plus 4 GB Swap. MUSS groesser sein als
# MEMORY_LIMIT, sonst ist der Swap-Deckel exakt mem_limit (AGENTS.md §9).
# Historie: 2g -> 3g -> 4g -> 5g. Auch 4 GB hat `opencode serve` als PID 1
# getoetet; Grund ist anon-Druck aus der Rust-Toolchain plus Chrome, nicht
# fehlender Swap. Messwerte: remote/README.md, "RAM- und Swap-Limits".
CPU_CORES=3
MEMORY_LIMIT=5g
MEMSWAP_LIMIT=9g
# Tailscale: privater Zugang zu Dev-Servern, die in code-dev laufen (pnpm dev o. ae.).
# LEER lassen = Stack laeuft ohne Tailnet, alles wie bisher. Mit Key sind die
# Ports im Container ueber die Tailnet-IP erreichbar (Userspace-Modus, ohne
# TUN/Capabilities/Port-Publishing). Der oeffentliche Weg mit Caddy +
# forward_auth bleibt unveraendert bestehen.
# Auth-Key aus der Tailscale-Admin-Console, NICHT ephemer, nie ins Repo.
# Plan und Sicherheitsregeln: remote/TAILSCALE-PLAN.md
TS_AUTHKEY=
# MagicDNS-Name im Tailnet (erscheint als <name>.<tailnet>.ts.net).
TS_TAILSCALE_HOSTNAME=code-dev
# KEIN HOST_GATEWAY mehr. `extra_hosts: host-gateway` wurde am 2026-09-26 mit
# Commit e5185dd entfernt ("Isolation schliessen") und ist live verifiziert:
# code-dev hat ExtraHosts=[], host.docker.internal loest nicht auf, Portainer-UI
# auf 8000 ist aus dem Container nicht erreichbar. Es hat localhost nie
# repariert, sondern nur eine Tuer zum ganzen VPS geoeffnet. Nicht wieder
# einfuegen — siehe remote/AGENTS.md Abschnitt 3.
