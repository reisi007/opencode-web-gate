# Beispiel-Umgebung. Kopieren nach `.env` via `./setup.sh`.
# Diese Datei committen, `.env` + `.env.production` nie (stehen in .gitignore).
# Echte Domains/Hosts nur in `.env` (lokal) bzw. `.env.production` (Portainer).

# --- Domains (Platzhalter ersetzen!) ---
CODE_DOMAIN=code.example.com
REMOTE_DOMAIN=remote-code.example.com
# Verzeichnisname unter /srv/websites auf dem VPS (oft = CODE_DOMAIN)
CODE_SITE=code.example.com
ADMIN_EMAIL=admin@example.com

# --- Tunnel ---
SSH_TARGET=user@vps.example.com
SSH_PORT=22
# VPS-Seite (fixer High-Port, kein Random — sonst Caddy-Reload nötig)
REMOTE_PORT=18731
# Bind-Adresse des Forwards auf dem VPS. Muss die Docker-Bridge sein (webnet-Gateway),
# weil Caddy im Bridge-Netz läuft und den VPS-Loopback nicht sieht.
# Braucht serverseitig: GatewayPorts clientspecified in /etc/ssh/sshd_config + reload.
REMOTE_BIND=172.18.0.1
# Mac-Seite (OpenCode-Web Default)
LOCAL_PORT=8080
# Setzt local/bootstrap.sh (beim Start via start-tunnel.command): der bestehende
# Key wird fuer den LaunchAgent nutzbar gemacht (Passphrase wandert einmalig in
# die macOS-Keychain, damit ssh ohne TTY connecten kann). Von Hand nicht setzen —
# bootstrap.sh pflegt beide Werte.
# SSH_IDENTITY=/Users/DEIN_NAME/.ssh/id_rsa
# SSH_KEY_AUTH=1
# Fixes Passwort fuer opencode serve (Pflicht). Caddy injiziert es per
# Authorization-Header upstream -> im Browser unsichtbar (de facto deaktiviert).
# Generiert setup.sh via: openssl rand -base64 24
OPENCODE_PASSWORD=

# --- Website-Sync (rclone, Zielhost + Pfad aus .env) ---
RCLONE_REMOTE=vps.example.com
RCLONE_PATH=/code.example.com
# Pfad relativ zu local/ (run.sh/sync.sh wechseln in dieses Verzeichnis)
LOCAL_DIST=apps/web/dist

# --- code-auth Sidecar (Portainer-Stack, webnet) ---
AUTH_USER=admin
# bcrypt-Hash via: docker run --rm caddy:2 caddy hash-password --plaintext 'PASSWORT'
# Fallback ohne Docker: pbkdf2-Format von setup.sh (pbkdf2$100000$salt$hash)
AUTH_HASH=
# 64 Hex-Chars, generiert setup.sh via: openssl rand -hex 32
AUTH_SECRET=
# statische webnet-IP (nächster freier Block nach .55 countdown, .253 ftp)
AUTH_IP=172.18.0.60
AUTH_PORT=8081
# Session-TTL in Sekunden (12h)
SESSION_TTL=43200

# --- code-remote (VPS-nativ, zweiter Weg neben Mac-Tunnel) ---
# Domain + Image. Keine Secrets hier — echte Werte in .env (lokal) bzw. Portainer.
REMOTE_DOMAIN=remote-code.example.com
IMAGE=ghcr.io/reisi007/opencode-web-dev-baseline:latest
# Ressourcenlimits fuer code-dev (CPU-Anzahl und RAM, z. B. 4 CPU / 8g).
CPU_CORES=3
MEMORY_LIMIT=4g
# Name, unter dem code-dev den VPS-Host erreicht. `localhost` im Container ist
# der Container selbst — Host-Dienste sind nur hierüber nutzbar (extra_hosts
# mit `host-gateway` im Stack, braucht Docker >= 20.10). Live auf dem VPS
# verifiziert: löst auf 172.17.0.1 (docker0) auf, nicht auf das Gateway des
# eigenen Netzes — beides ist der Host. Achtung: der Dienst muss auf 0.0.0.0
# binden, auf 127.0.0.1 lauscht er bleibt unerreichbar.
# Muss auch in remote/.env.production (globales Portainer-Env) stehen.
HOST_GATEWAY=host.docker.internal
