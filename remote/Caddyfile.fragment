# Fragment ZWEITER Weg: __REMOTE_DOMAIN__ (VPS-nativ, Mac-Tunnel bleibt).
# Ablage NUR als Vorlage hier — echte Secrets nie committen, Platzhalter
# manuell fuellen (siehe Root-README: Passwoerter & Caddy-Basic).
# Dann im caddyfile-Repo in Caddyfile uebernehmen + ./sync.sh (validate + reload).
# Voraussetzung VPS: Stack `code-remote` laeuft (stack/docker-compose.remote.yml),
# Caddy haengt zusaetzlich im externen Netz `code-remote` (siehe remote/README.md).
__REMOTE_DOMAIN__ {
	import security_headers
	import compress

	# statische Login-Seite (gleiche wie __CODE_DOMAIN__, rclone aus apps/web/dist)
	handle /login.html {
		root * /srv/websites/__CODE_SITE__
		file_server
	}

	# Login-API an isolierten Sidecar (nur code-remote-Netz, kein webnet)
	handle /api/login {
		reverse_proxy code-auth-remote:8081
	}
	handle /api/me {
		reverse_proxy code-auth-remote:8081
	}
	handle /api/logout {
		reverse_proxy code-auth-remote:8081
	}

	# OpenCode-SW precache-Bug neutralisieren (wie Mac-Fragment)
	handle /sw.js {
		header Content-Type "application/javascript"
		respond `/* service worker disabled */` 200
	}

	# alles andere: Cookie pruefen, dann VPS-Container (kein SSH-Tunnel).
	handle {
		forward_auth code-auth-remote:8081 {
			# Auth-Preflight bewusst als kurze HTTP/1.1-Verbindung: der
			# Python-Sidecar ist HTTP/1.0 und soll keinen Idle-Pool aufbauen.
			transport http {
				versions 1.1
				keepalive off
			}
			uri /check?
			copy_headers Remote-User
			@denied status 401
			handle_response @denied {
				redir * /login.html 302
			}
		}
		reverse_proxy code-dev:8080 {
			# PLATZHALTER — manuell ersetzen (siehe Root-README).
			header_up Authorization "__OPENCODE_BASIC__"

			# Direkter, authentisierter Healthcheck auf denselben Container:
			# ein unerreichbarer oder nicht bereiter Upstream wird für neue
			# Requests als unhealthy markiert.
			health_uri /api/info
			health_interval 30s
			health_timeout 4s
			health_status 200
			health_fails 3
			health_headers {
				Authorization "__OPENCODE_BASIC__"
			}

			# Browser->Caddy darf HTTP/2 bleiben. Für Caddy->OpenCode nur HTTP/1.1:
			# OpenCode antwortet mit Keep-Alive: timeout=5; Cadys 2m-Default kann
			# abgelaufene Upstream-Sockets wiederverwenden (502/WS-Resets).
			transport http {
				versions 1.1
				keepalive 4s
				keepalive_interval 1s
			}

			# Aktive Streams nicht unbegrenzt halten: nach 24h wird die alte
			# Verbindung sauber beendet, damit der V2-Client neu verbindet.
			stream_timeout 24h
			stream_close_delay 5m

			# SSE und WebSockets streamt Caddy automatisch. Kein globales
			# flush_interval -1: dadurch wuerde Caddy Upstream-Requests bei
			# Client-Abbruch nicht sauber abbrechen.
		}
	}

	handle_errors {
		@gw expression `{err.status_code} == 502 || {err.status_code} == 503 || {err.status_code} == 504`
		handle @gw {
			root * /srv/websites/__CODE_SITE__
			rewrite * /tunnel-down.html
			file_server
		}
	}
}
