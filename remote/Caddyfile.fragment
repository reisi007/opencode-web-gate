# Fragment ZWEITER Weg: __REMOTE_DOMAIN__ (VPS-nativ, Mac-Tunnel bleibt).
# Ablage NUR als Vorlage hier — echte Secrets nie committen, Platzhalter
# manuell fuellen (siehe Root-README: Passwoerter & Caddy-Basic).
# Platzhalter zum Ersetzen: __REMOTE_DOMAIN__, __CODE_SITE__, __OPENCODE_BASIC__,
# __CORS_ORIGIN__ (nur die eigene PWA-Origin), __OPENCODE_USER__,
# __OPENCODE_BASIC_HASH__ (bcrypt des OPENCODE_PASSWORD, siehe @api-Block).
# Achtung, zwei verschiedene Basic-Formate: __OPENCODE_BASIC__ ist
# base64("user:pass") und wird per header_up INJIZIERT, __OPENCODE_BASIC_HASH__
# ist ein bcrypt-Hash ($2a$...) und wird von basic_auth VERGLICHEN. Nicht
# verwechseln, nicht base64-en.
#
# Unersetzt ist die Datei fuer __REMOTE_DOMAIN__/__CODE_SITE__/__OPENCODE_BASIC__/
# __CORS_ORIGIN__ weiterhin syntaktisch gueltig und liefert still eine
# unbrauchbare Response. __OPENCODE_BASIC_HASH__ ist die Ausnahme: Caddy
# dekodiert alles ohne `$`-Praefix als base64 und bricht validate hart ab
# ("illegal base64 data"). Das ist der bessere Ausgang — ein nicht
# deploybarer Stack statt eines stillen Fehlschlags.
# Dann im caddyfile-Repo in Caddyfile uebernehmen + ./sync.sh (validate + reload).
# Voraussetzung VPS: Stack `code-remote` laeuft (stack/docker-compose.remote.yml),
# Caddy haengt zusaetzlich im externen Netz `code-remote` (siehe remote/README.md).
__REMOTE_DOMAIN__ {
	import security_headers
	import compress

	# statische Login-Seite (gleiche wie __CODE_DOMAIN__, rsync/ssh aus apps/web/dist)
	handle /login.html {
		root * /srv/websites/__CODE_SITE__
		file_server
	}

	# Login-API an isolierten Sidecar (nur code-remote-Netz, kein webnet)
	handle /api/login {
		reverse_proxy code-auth-remote:8081
	}
	handle /api/me {
		reverse_proxy code-auth-remote:8081
	}
	handle /api/logout {
		reverse_proxy code-auth-remote:8081
	}

	# OpenCode-SW precache-Bug neutralisieren (wie Mac-Fragment)
	handle /sw.js {
		header Content-Type "application/javascript"
		respond `/* service worker disabled */` 200
	}

	# CORS-Preflight (PWA __CORS_ORIGIN__): OPTIONS traegt nie Cookies,
	# forward_auth antwortete mit 302 und der Browser brach den Preflight ab
	# (gemessen 2026-10-07: OPTIONS /api/info -> 302, kein
	# Access-Control-Allow-Origin). Deshalb hier beantworten, bevor das
	# Catch-all greift. ACAO an echten Responses SOLL opencode serve --cors
	# liefern (Key CORS_ORIGIN, remote/AGENTS.md §18) — unbelegt, s. §19.
	#
	# Grenze: die pfadspezifischen Handles DARUEBER (/login.html, /api/login,
	# /api/me, /api/logout, /sw.js) stehen vor diesem Block. Das ist
	# Quellreihenfolge per stabilem Sort, keine Absicht: der Pfad-Sub-Sort
	# (sortRoutes in caddyconfig/httpcaddyfile/directives.go) greift nur, wenn
	# BEIDE Routen genau einen Single-Path-Matcher haben; @options matcht per
	# method, also sagt der Comparator nur "beide haben einen Matcher" = gleich.
	# Ein OPTIONS darauf trifft diesen Block NIE:
	#   /api/login|me|logout -> Sidecar, kennt nur do_GET/do_POST, kein
	#     do_OPTIONS (Beleg: dieser Datei-Heredoc in remote/docker-compose.yml)
	#     -> 501 ohne CORS-Header
	#   /sw.js               -> das eigene respond 200, ohne CORS-Header
	#   /login.html          -> file_server, ohne CORS-Header
	# Heute harmlos (Login ist same-origin, kein Preflight noetig), latente
	# Falle sobald das Login cross-origin wird.
	#
	# Reichweite: dieses Blanket-OPTIONS umgeht forward_auth fuer ALLE
	# uebrigen Pfade. Das ist statisch und bodyless, der Upstream sieht
	# nichts davon, es ist nichts preisgegeben. Aber kuenftige Endpunkte, die
	# selbst OPTIONS tragen (WebDAV-Discovery o.ae.), wuerden hier maskiert.
	#
	# OFFEN: die Allow-Headers-Liste ist geraten. Aus dem echten
	# Access-Control-Request-Headers ableiten (DevTools-Netz-Tab der PWA).
	@options method OPTIONS
	handle @options {
		header Access-Control-Allow-Origin "__CORS_ORIGIN__"
		header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
		header Access-Control-Allow-Headers "Authorization, Content-Type"
		header Access-Control-Allow-Credentials "true"
		header Access-Control-Max-Age "86400"
		respond "" 204
	}

	# /api/* fuer die PWA: Basic-Gate am Edge (Option B aus
	# opencode-pwa features/06-remote-access.md), KEIN forward_auth. Das
	# Cookie-Gate kann cross-origin nicht passieren (SameSite=Lax, gemessen),
	# die PWA sendet aber per Request `Authorization: Basic` (features/02).
	#
	# Warum nicht `forward_auth` mit durchgereichtem Cookie: Lax heisst, der
	# Browser sendet das Cookie bei cross-site fetch gar nicht. Und warum nicht
	# einfach den Client-Header durchreichen: `header_up Authorization` im
	# Catch-all ersetzt ihn — das Client-Basic erreicht opencode nie, also
	# muss Caddy es selbst pruefen und danach das Server-Passwort injizieren.
	#
	# Das Passwort ist OPENCODE_PASSWORD (Serverpasswort), NICHT AUTH_HASH
	# (Login-Cookie) — die beiden duerfen pro Weg verschieden sein
	# (Gate-AGENTS.md §4/§13). Der Hash kommt aus `caddy hash-password
	# --plaintext "$OPENCODE_PASSWORD"`; die AUSGABE dieses Kommandos ist der
	# Wert fuer __OPENCODE_BASIC_HASH__, unquoted und im Modular-Crypt-Format
	# ($2a$...). Kein base64 — ein base64-Wert laeuft in Cadys base64-Zweig und
	# bricht validate mit "illegal base64 data".
	#
	# Der User-Teil ist NICHT frei waehlbar: Cadys basic_auth macht einen
	# Map-Lookup auf den Usernamen (caddyauth/basicauth.go), ein unbekannter
	# User ist ein 401. __OPENCODE_USER__ muss exakt der Username sein, den
	# die PWA im Vault fuer diesen Server hinterlegt hat
	# (opencode-pwa features/02-api-contract.md: Basic pro Server aus dem
	# Vault). Falscher Name = jeder PWA-Request laeuft ins 401.
	#
	# Reihenfolge/Abdeckung: die exakten Pfad-Handles /api/login, /api/me,
	# /api/logout stehen DARUEBER und behalten ihre Quellreihenfolge (stabiler
	# Sort, Begründung beim @options-Block) — sie gehen NICHT durch dieses
	# Basic-Gate, sie bleiben am Cookie-Gate. Das ist Absicht: die Login-API
	# des Sidecars kennt kein Basic.
	#
	# LADEN-TRAGEND: @api muss UNTER @options stehen. Beide Matcher fallen in
	# dieselbe Comparator-Klasse („hat einen Matcher"), ihre Reihenfolge haengt
	# allein an der Quelle. @api VOR @options gemessen: OPTIONS /api/info → 401
	# statt 204, der Preflight stirbt lautlos. Beim Umbau nicht vertauschen.
	# ACHTUNG: NUR wenn ein Authorization-Header mitkommt. Die Web-UI laeuft
	# auf derselben Domain und ruft /api/* cookie-authentifiziert auf — ohne
	# diesen Zusatz laeuft sie ins Basic-Gate, bekommt 401 + WWW-Authenticate
	# und der Browser zeigt seinen nativen Passwort-Dialog (gemessen
	# 2026-10-07, Live-Folge des ersten Deploys). Ohne Authorization-Header
	# faellt der Request hier durch in den Catch-all mit forward_auth, also
	# in das Cookie-Gate — das ist der Browser-Weg.
	@api {
		path /api/*
		header Authorization *
	}
	handle @api {
		basic_auth {
			__OPENCODE_USER__ __OPENCODE_BASIC_HASH__
		}
		reverse_proxy code-dev:8080 {
			# Intern auf das Opcode-Passwort swappen: der Client schickt das
			# Client-Basic, opencode erwartet sein eigenes. basic_auth prueft den
			# EINGEHENDEN Request, header_up aendert den AUSGEHENDEN — die
			# Reihenfolge der beiden ist dafuer unerheblich, die Pruefung kann
			# dadurch nicht umgangen werden (belegt am Adapt-JSON).
			header_up Authorization "__OPENCODE_BASIC__"
			header_up Host code-dev

			# Gleicher Upstream-Transport und dieselben Stream-Grenzen wie
			# unten im Catch-all: HTTP/1.1 + kurzes Keepalive (opencode
			# antwortet Keep-Alive: timeout=5), WebSocket 24h, SSE unberuehrt.
			transport http {
				versions 1.1
				keepalive 4s
			}
			stream_timeout 24h
			stream_close_delay 5m
		}

		# ACAO/ACAC auf den echten Responses (Sibling von reverse_proxy, NICHT
		# darin — `header` ist keine reverse_proxy-Subdirektive und macht die
		# ganze Datei unadaptierbar, beide Sites tot). defer, damit
		# Proxy-Responses spaeter gesetzte Header ueberschreiben koennen.
		#
		# BEGRENZT (gemessen): die 401 aus basic_auth traegt diese Header NICHT.
		# basic_auth gibt bei Fehlschlag keinen normalen Response zurueck,
		# sondern caddyhttp.Error, und der defer-Wrapper wird im Error-Pfad
		# umgangen — die PWA sieht dann nur einen CORS-Fehler statt einer 401.
		# Reparatur ist der ACAO-Zweig in handle_errors unten (Entscheidung
		# 2026-10-07), NICHT dieser defer-Block.
		# opencode --cors liefert ACAO auch (Key CORS_ORIGIN, §18) — das ist
		# unbelegt, s. §19.
		header {
			Access-Control-Allow-Origin "__CORS_ORIGIN__"
			Access-Control-Allow-Credentials "true"
			Vary Origin
			defer
		}
	}

	# alles andere: Cookie pruefen, dann VPS-Container (kein SSH-Tunnel).
	handle {
		forward_auth code-auth-remote:8081 {
			# Auth-Preflight bewusst als kurze HTTP/1.1-Verbindung: der
			# Python-Sidecar ist HTTP/1.0 und soll keinen Idle-Pool aufbauen.
			transport http {
				versions 1.1
				keepalive off
			}
			uri /check?
			copy_headers Remote-User
			@denied status 401
			handle_response @denied {
				redir * /login.html 302
			}
		}
		reverse_proxy code-dev:8080 {
			# PLATZHALTER — manuell ersetzen (siehe Root-README).
			header_up Authorization "__OPENCODE_BASIC__"

			# Direkter, authentisierter Healthcheck auf denselben Container:
			# ein unerreichbarer oder nicht bereiter Upstream wird für neue
			# Requests als unhealthy markiert.
			health_uri /api/info
			health_interval 30s
			health_timeout 4s
			health_status 200
			health_fails 3
			health_headers {
				Authorization "__OPENCODE_BASIC__"
			}

			# Browser->Caddy darf HTTP/2 bleiben. Für Caddy->OpenCode nur HTTP/1.1:
			# OpenCode antwortet mit Keep-Alive: timeout=5; Cadys 2m-Default kann
			# abgelaufene Upstream-Sockets wiederverwenden (502/WS-Resets).
			transport http {
				versions 1.1
				keepalive 4s
			}

			# WebSocket-Upgrades (z.B. PTY) begrenzen; SSE bleibt davon unberührt.
			stream_timeout 24h
			# Beim Caddy-Reload den Abbruch alter WebSocket-Streams verzögern.
			stream_close_delay 5m

			# Caddy puffert SSE automatisch. Kein globales flush_interval -1:
			# es ist redundant und würde auch alle normalen Responses beeinflussen.
		}
	}

	handle_errors {
		# 401 des Basic-Gates an der PWA lesbar machen (2026-10-07). Ohne das
		# sieht die PWA bei falschem Passwort "Failed to fetch" statt "401"
		# (gemessen: der defer-Block am @api-Handle traegt die basic_auth-401
		# nicht, weil basic_auth per caddyhttp.Error antwortet und der
		# defer-Wrapper im Error-Pfad umgangen wird). Deshalb hier, im
		# Error-Handler, wo die Antwort tatsaechlich entsteht.
		#
		# Abgegrenzt auf /api/*: die 401 des Cookie-Pfads (forward_auth) laeuft
		# als handle_response-Redirect durch und erreicht handle_errors nicht.
		@api401 expression `{err.status_code} == 401 && {path}.startsWith("/api/")`
		handle @api401 {
			header {
				Access-Control-Allow-Origin "__CORS_ORIGIN__"
				Access-Control-Allow-Credentials "true"
				Vary Origin
			}
			respond "Unauthorized" 401
		}

		@gw expression `{err.status_code} == 502 || {err.status_code} == 503 || {err.status_code} == 504`
		handle @gw {
			root * /srv/websites/__CODE_SITE__
			rewrite * /tunnel-down.html
			file_server
		}
	}
}
